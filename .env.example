# Flask Configuration
SECRET_KEY=your-secret-key-here-generate-with-python-secrets

# Deployment Configuration
DEPLOY_HOST=your.host.com
DEPLOY_USER=your_username
DEPLOY_BASE_DIR=your_path/
DEPLOY_SUB_DIR=optional_subdir/
DEPLOY_BACKEND_ROOT=/full/path/to/htdocs/
PRODUCTION_DOMAIN=https://yourdomain.com

# CORS Configuration (comma-separated list of allowed origins for production)
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=

# Database Configuration (optional, defaults to local sqlite)
# DB_PATH=/path/to/database/app.db

# SMTP
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM_EMAIL=accounts@nosebeep.com
SMTP_FROM_NAME="Nose Beep Enterprises"
SMTP_USERNAME=accounts@nosebeep.com
SMTP_PASSWORD=**password here**
# Optional override, including any deployment subdirectory.
# Local default: http://localhost:3000/<DEPLOY_SUB_DIR>/reset-password
# Deployment default: <PRODUCTION_DOMAIN>/<DEPLOY_SUB_DIR>/reset-password
# PASSWORD_RESET_URL=https://yourdomain.com/reset-password

# LLM Configuration
# LLM_PROVIDER selects 'ollama' or 'openrouter'. If unset, it defaults to
# 'ollama' for local development and 'openrouter' when FLASK_ENV=production.
# LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Environment
FLASK_ENV=development
DEBUG=0

# Generate a secure SECRET_KEY with:
# python3 -c "import secrets; print(secrets.token_hex(32))"

